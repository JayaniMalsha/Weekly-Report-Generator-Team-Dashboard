PORT=5000
# For local SQLite (Zero setup, runs out of the box):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://user:password@localhost:5432/weekly_reports?schema=public"

JWT_SECRET="your-jwt-secret-key-replace-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Optional LLM API keys for AI Assistant (if not set, built-in intelligent contextual NLP engine handles all queries)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
